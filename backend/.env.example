# MindBridge backend configuration. Copy to .env and edit as needed.
# The service runs fully offline with zero configuration; these are optional.

# Enable Claude-powered reasoning (translation, verification, handover summaries).
# Without this, the deterministic on-device engine is used.
# ANTHROPIC_API_KEY=sk-ant-...

# Model id used when Claude is enabled.
# MINDBRIDGE_MODEL=claude-opus-4-8

# Force the offline heuristic engine even if a key is present (deterministic).
# MINDBRIDGE_FORCE_OFFLINE=false

# Understanding Score below this triggers an automatic clarification loop.
# MINDBRIDGE_UNDERSTANDING_THRESHOLD=70

# Comma-separated allowed CORS origins for the frontend.
# MINDBRIDGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
